; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it can be edited, this one goes through all the basics.

config_version=5

[application]

config/name="Triangle Art"
config/description="삼각형으로 만드는 그림 - Triangle Art"
config/icon="res://assets/icons/icon.png"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.024, 0.035, 0.067, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

[gui]

theme/custom="res://assets/theme/app_theme.tres"
theme/custom_font="res://assets/fonts/korean_font.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true
